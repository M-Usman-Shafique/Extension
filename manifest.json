{
  "manifest_version": 3,
  "name": "Nerd Mode",
  "version": "1.0.0",
  "description": "Change the background color of web pages",
  "author": "hafizusmanshafiq@gmail.com",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "nerd.png",
      "32": "nerd.png",
      "48": "nerd.png",
      "128": "nerd.png"
    }
  },
  "icons": {
    "16": "nerd.png",
    "32": "nerd.png",
    "48": "nerd.png",
    "128": "nerd.png"
  },
  "permissions": ["activeTab", "storage", "notifications"],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"]
    }
  ]
}
